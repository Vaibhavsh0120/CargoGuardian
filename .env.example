# Public app config
NEXT_PUBLIC_APP_NAME=CargoGuardian
NEXT_PUBLIC_APP_URL=https://cargo-guardian-red.vercel.app/
NEXT_PUBLIC_DEMO_MODE=true

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin config
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Blynk config
BLYNK_BASE_URL=https://blynk.cloud
BLYNK_WEBHOOK_SECRET=
BLYNK_TEMPLATE_ID=TMPL3TPA6EnbV
BLYNK_TEMPLATE_NAME=CargoGuardian ESP32

# GPS fallback for hackathon use when a real GPS sensor is unavailable.
# These values are used only when an ingest payload omits GPS coordinates.
DEFAULT_GPS_LAT=32.0809
DEFAULT_GPS_LNG=34.7806

# TigerGraph
TIGERGRAPH_BASE_URL=https://tg-xxx.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=CargoNetwork
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=
TIGERGRAPH_API_KEY=

# Session and admin setup
SESSION_COOKIE_SECRET=
ADMIN_INVITE_SECRET=
LOG_LEVEL=info

# Map config is intentionally omitted from the active setup.
# Future map work should use a free stack and not require paid Mapbox access.
